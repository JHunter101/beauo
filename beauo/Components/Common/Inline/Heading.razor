@namespace Beauo.Components

@if (Level == 1)
{
	<h1 class="@Align.Name">
		<Text ChildContent="@ChildContent" Size="@Size" Color="@Color" />
	</h1>
}
else if (Level == 2)
{
	<h2 class="@Align.Name">
		<Text ChildContent="@ChildContent" Size="@Size" Color="@Color" />
	</h2>
}
else if (Level == 3)
{
	<h3 class="@Align.Name">
		<Text ChildContent="@ChildContent" Size="@Size" Color="@Color" />
	</h3>
}
else if (Level == 4)
{
	<h4 class="@Align.Name">
		<Text ChildContent="@ChildContent" Size="@Size" Color="@Color" />
	</h4>
}
else if (Level == 5)
{
	<h5 class="@Align.Name">
		<Text ChildContent="@ChildContent" Size="@Size" Color="@Color" />
	</h5>
}
else
{
	<h6 class="@Align.Name">
		<Text ChildContent="@ChildContent" Size="@Size" Color="@Color" />
	</h6>
}

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; }
    [Parameter] public int Level { get; set; } = 1;
    [Parameter] public TextSizeClass Size { get; set; } = TextSizeClass.Large;
	[Parameter] public FgColorVar? Color { get; set; }
	[Parameter] public TextAlignClass Align { get; set; } = TextAlignClass.Left;
}