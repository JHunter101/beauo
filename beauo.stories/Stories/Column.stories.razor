@attribute [Stories("Examples/Column")]

<Stories TComponent="Column" Layout="typeof(CenteredLayout)">

    <ArgType For="_ => _.ChildContent" />
    <ArgType For="_ => _.Gap" />
    <ArgType For="_ => _.Align" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _.ChildContent" Value="_content" />
        </Arguments>
        <Template>
            <Column @attributes="context.Args" />
        </Template>
    </Story>

</Stories>

@code {
    private RenderFragment _content = @<text>
        <Text>Top</Text>
        <Text>Bottom</Text>
    </text>;
}
