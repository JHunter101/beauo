@attribute [Stories("Examples/Input")]

<Stories TComponent="Input" Layout="typeof(CenteredLayout)">

    <ArgType For="_ => _.ChildContent" />
    <ArgType For="_ => _.Value" />
    <ArgType For="_ => _.IsDisabled" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _.ChildContent" Value="_label" />
            <Arg For="_ => _.Value" Value='"Hello"' />
        </Arguments>
        <Template>
            <Input @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Disabled">
        <Arguments>
            <Arg For="_ => _.ChildContent" Value="_label" />
            <Arg For="_ => _.Value" Value='"Disabled"' />
            <Arg For="_ => _.IsDisabled" Value="true" />
        </Arguments>
        <Template>
            <Input @attributes="context.Args" />
        </Template>
    </Story>

</Stories>

@code {
    private RenderFragment _label = @<text>Label</text>;
}
