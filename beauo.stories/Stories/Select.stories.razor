@attribute [Stories("Examples/Select")]

<Stories TComponent="Select<string>" Layout="typeof(CenteredLayout)">

    <ArgType For="_ => _.Label" />
    <ArgType For="_ => _.Value" />
    <ArgType For="_ => _.Options" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Choose"' />
            <Arg For="_ => _.Options" Value="_options" />
            <Arg For="_ => _.Value" Value='"One"' />
        </Arguments>
        <Template>
            <Select TValue="string" @attributes="context.Args" />
        </Template>
    </Story>

</Stories>

@code {
    private IEnumerable<string> _options = new[] { "One", "Two", "Three" };
}
