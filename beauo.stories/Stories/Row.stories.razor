@attribute [Stories("Examples/Row")]

<Stories TComponent="Row" Layout="typeof(CenteredLayout)">

    <ArgType For="_ => _.ChildContent" />
    <ArgType For="_ => _.Gap" />
    <ArgType For="_ => _.Align" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _.ChildContent" Value="_content" />
        </Arguments>
        <Template>
            <Row @attributes="context.Args" />
        </Template>
    </Story>

</Stories>

@code {
    private RenderFragment _content = @<text>
        <Column><Text>Left</Text></Column>
        <Column><Text>Right</Text></Column>
    </text>;
}
