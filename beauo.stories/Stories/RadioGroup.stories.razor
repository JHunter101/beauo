@attribute [Stories("Examples/RadioGroup")]

<Stories TComponent="RadioGroup<string>" Layout="typeof(CenteredLayout)">

    <ArgType For="_ => _.Value" />
    <ArgType For="_ => _.Options" />
    <ArgType For="_ => _.Label" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Choose one"' />
            <Arg For="_ => _.Options" Value="_options" />
            <Arg For="_ => _.Value" Value='"One"' />
        </Arguments>
        <Template>
            <div>
                <RadioGroup TValue="string" @attributes="context.Args" ValueChanged="@((string v) => OnSelect(v))" />
                <Text>@($"Selected: {_selected}")</Text>
            </div>
        </Template>
    </Story>

</Stories>

@code {
    private HashSet<string> _options = new() { "One", "Two", "Three" };
    private string _selected = "One";

    private void OnSelect(string v)
    {
        _selected = v;
    }
}
